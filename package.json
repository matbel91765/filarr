{
  "name": "filarr",
  "version": "2.6.0",
  "description": "Privacy-first local file & note vault. Encrypted, offline, cross-platform.",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none react-app-rewired start\" \"npm run electron:build && wait-on http://localhost:3000 && electron .\"",
    "electron": "npm run electron:build && electron .",
    "electron:build": "tsc -p electron/tsconfig.json",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "test:coverage": "react-app-rewired test --coverage",
    "test:ci": "react-app-rewired test --coverage --watchAll=false",
    "electron:dev": "npm run electron:build && electron .",
    "electron:build:app": "electron-builder",
    "type-check": "tsc --noEmit",
    "type-check:electron": "tsc -p electron/tsconfig.json --noEmit",
    "package": "npm run build && npm run electron:build && npm run electron:build:app",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "keywords": [
    "electron",
    "react",
    "notes",
    "encryption",
    "vault",
    "local-first",
    "privacy"
  ],
  "license": "BUSL-1.1",
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@electron/fuses": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/redux-logger": "^3.0.13",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "autoprefixer": "^10.4.24",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "html-webpack-plugin": "^5.6.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prop-types": "^15.8.1",
    "react-scripts": "^5.0.1",
    "sharp": "^0.34.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.1",
    "@tiptap/extension-bubble-menu": "^3.20.1",
    "@tiptap/extension-code-block-lowlight": "^3.20.1",
    "@tiptap/extension-color": "^3.20.1",
    "@tiptap/extension-highlight": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-mention": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-table": "^3.20.1",
    "@tiptap/extension-table-cell": "^3.20.1",
    "@tiptap/extension-table-header": "^3.20.1",
    "@tiptap/extension-table-row": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/extension-text-style": "^3.20.1",
    "@tiptap/extension-typography": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/suggestion": "^3.20.1",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "buffer": "^6.0.3",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "crypto-browserify": "^3.12.1",
    "d3-force": "^3.0.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.0",
    "dotenv": "^16.4.5",
    "electron-log": "^5.1.7",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.2.1",
    "flexsearch": "^0.8.212",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.11.1",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.2.1",
    "katex": "^0.16.38",
    "lowlight": "^3.3.0",
    "marked": "^17.0.1",
    "mermaid": "^11.13.0",
    "pdfjs-dist": "^4.0.379",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-app-rewired": "^2.2.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^16.3.3",
    "react-icons": "^5.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.26.0",
    "react-toastify": "^10.0.5",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-virtuoso": "^4.18.3",
    "react-window": "^1.8.11",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "stream-browserify": "^3.0.0",
    "vm-browserify": "^1.1.2",
    "ws": "^8.19.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30"
  },
  "build": {
    "extends": null,
    "appId": "com.filarr.app",
    "productName": "Filarr",
    "files": [
      "build/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "buildResources"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/argon2/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "extraResources": [
      {
        "from": "public/icons/",
        "to": "public/icons/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/favicon-64.png",
        "to": "public/favicon-64.png"
      },
      {
        "from": "public/logo512.png",
        "to": "public/logo512.png"
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
